---
import { SITE_TITLE, SITE_TAGLINE, SITE_DESCRIPTION } from '../consts';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS as projects } from '../domains/portfolio/projects';
import ProjectList from '../components/ProjectList.astro'

const top3Projects = projects.slice(0, 1);
---

<BaseLayout title={SITE_TITLE + ' - ' + SITE_TAGLINE} description={SITE_DESCRIPTION}>
	<div class='container'>
		<div class='page-stack'>
			<!-- Documentation Style Hero Section -->
			<section class='page-intro max-w-4xl'>
				<!-- Semantic Header Container -->
				<header class='flex flex-col gap-6 pt-1 sm:pt-2'>
					<!-- Name -->
					<h1 class='text-3xl sm:text-4xl font-bold text-zinc-100 font-mono tracking-wide leading-tight text-balance'>
						Leandro de Oliveira Barbosa
					</h1>

					<div class='flex flex-col gap-4'>
						<!-- Headtitle -->
						<h2 class='measure-text text-xl sm:text-2xl leading-relaxed text-zinc-100 font-medium text-pretty'>
							<span class='text-[var(--color-accent)]'>DevOps Engineer</span> com foco em automação, CI/CD, infraestrutura Cloud e Kubernetes.
						</h2>

						<!-- Description -->
						<p class='measure-text text-base sm:text-lg leading-relaxed text-zinc-400 text-pretty'>
							Atuo na entrega e operação de workloads Cloud Native, aplicando Terraform, GitOps, observabilidade e práticas de Platform Engineering para reduzir fricção e aumentar governança.
						</p>
					</div>

					<!-- Isolated CTA -->
					<div class='mt-2'>
						<a href='/sobre/' class='inline-flex w-full sm:w-auto items-center justify-center gap-2 px-3 py-2 rounded-md bg-zinc-900/40 border border-zinc-800 hover:bg-zinc-900/80 hover:border-zinc-700 transition-all duration-300 font-mono text-sm text-zinc-400 hover:text-[var(--color-accent)] group'>
							<span class='text-[var(--color-accent)] opacity-80 group-hover:opacity-100'>$ cat</span> sobre.md
							<svg class='transition-transform duration-300 group-hover:translate-x-1' xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
								<path d='M5 12h14'/><path d='m12 5 7 7-7 7'/>
							</svg>
						</a>
					</div>
				</header>

				<!-- Workload Request Snapshot -->
				<div class='mt-10 max-w-2xl overflow-hidden rounded-sm border border-zinc-800 bg-zinc-950/70'>
					<div class='flex items-center justify-between gap-3 border-b border-zinc-800/80 bg-zinc-900/40 px-4 py-2'>
						<span class='text-[10px] font-mono uppercase tracking-widest text-zinc-500'>FLOWDX / workload request</span>
						<span class='rounded-full border border-teal-500/20 bg-teal-500/10 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-[var(--color-accent)]'>ready</span>
					</div>
					<div class='p-3 sm:p-4'>
						<dl class='grid grid-cols-1 gap-2 sm:grid-cols-2'>
							<div class='border border-zinc-800/70 bg-zinc-900/30 px-3 py-2'>
								<dt class='font-mono text-[10px] uppercase tracking-widest text-zinc-600'>Workload</dt>
								<dd class='mt-0.5 font-mono text-sm text-zinc-200'>reference-api</dd>
							</div>
							<div class='border border-zinc-800/70 bg-zinc-900/30 px-3 py-2'>
								<dt class='font-mono text-[10px] uppercase tracking-widest text-zinc-600'>Environment</dt>
								<dd class='mt-0.5 font-mono text-sm text-zinc-200'>staging</dd>
							</div>
							<div class='border border-zinc-800/70 bg-zinc-900/30 px-3 py-2'>
								<dt class='font-mono text-[10px] uppercase tracking-widest text-zinc-600'>Runtime</dt>
								<dd class='mt-0.5 font-mono text-sm text-zinc-200'>FastAPI</dd>
							</div>
							<div class='border border-zinc-800/70 bg-zinc-900/30 px-3 py-2'>
								<dt class='font-mono text-[10px] uppercase tracking-widest text-zinc-600'>Delivery</dt>
								<dd class='mt-0.5 font-mono text-sm text-zinc-200'>GitOps / ArgoCD</dd>
							</div>
						</dl>

						<div class='mt-4'>
							<p class='font-mono text-[10px] uppercase tracking-widest text-zinc-600'>Required checks</p>
							<ul class='mt-2 space-y-1.5 text-sm leading-snug text-zinc-400'>
								<li class='flex gap-3'>
									<span aria-hidden='true' class='font-mono text-[var(--color-accent)]'>✓</span>
									<span class='min-w-0 text-pretty'>flowdx.yaml accepted</span>
								</li>
								<li class='flex gap-3'>
									<span aria-hidden='true' class='font-mono text-[var(--color-accent)]'>✓</span>
									<span class='min-w-0 text-pretty'>image published to GHCR</span>
								</li>
								<li class='flex gap-3'>
									<span aria-hidden='true' class='font-mono text-[var(--color-accent)]'>✓</span>
									<span class='min-w-0 text-pretty'>Helm chart valid</span>
								</li>
								<li class='flex gap-3'>
									<span aria-hidden='true' class='font-mono text-[var(--color-accent)]'>✓</span>
									<span class='min-w-0 text-pretty'>Kyverno policies passed</span>
								</li>
								<li class='flex gap-3'>
									<span aria-hidden='true' class='font-mono text-[var(--color-accent)]'>✓</span>
									<span class='min-w-0 text-pretty'>image digest prepared</span>
								</li>
							</ul>
						</div>

						<div class='mt-4 border-t border-zinc-900 pt-2.5'>
							<p class='font-mono text-xs text-zinc-200'>
								<span class='text-zinc-600'>Status:</span>
								<span class='text-[var(--color-accent)]'>ready for governed merge</span>
							</p>
						</div>
					</div>
				</div>
			</section>

			<!-- Projects - Markdown Style Header -->
			<section class='flex flex-col gap-8'>
				<div class='flex flex-col items-start justify-between gap-4 border-b border-zinc-800/50 pb-4 sm:flex-row sm:items-center'>
					<h2 class='section-heading'>## Projeto em Destaque</h2>
					<a href='/projetos/' class='inline-flex w-full sm:w-auto items-center justify-center gap-2 px-3 py-2 rounded-md bg-zinc-900/40 border border-zinc-800 hover:bg-zinc-900/80 hover:border-zinc-700 transition-all duration-300 font-mono text-sm text-zinc-400 hover:text-[var(--color-accent)] group'>
						<span class='text-[var(--color-accent)] opacity-80 group-hover:opacity-100'>$ ls</span> ./projetos
						<svg class='transition-transform duration-300 group-hover:translate-x-1' xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
							<path d='M5 12h14'/><path d='m12 5 7 7-7 7'/>
						</svg>
					</a>
				</div>
				<ProjectList projects={top3Projects} featured={true} horizontal={true}/>
			</section>
		</div>
	</div>
</BaseLayout>
