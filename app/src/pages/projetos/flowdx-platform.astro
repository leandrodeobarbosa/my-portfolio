<script>
  // @ts-nocheck
  var observer = null;
  var isInitialized = false;
  var eventController = null;
  var activeTimers = [];

  function cleanup() {
    if (observer) {
      observer.disconnect();
      observer = null;
    }
    if (eventController) {
      eventController.abort();
      eventController = null;
    }
    activeTimers.forEach(function(timer) {
      clearTimeout(timer);
    });
    activeTimers = [];
    isInitialized = false;
  }

  function init() {
    if (isInitialized) {
      cleanup();
    }

    var navLinks = document.querySelectorAll('.nav-link');

    if (navLinks.length === 0) return;

    eventController = new AbortController();
    var eventSignal = eventController.signal;

    var validSectionIds = [];
    navLinks.forEach(function(link) {
      var sectionId = link.getAttribute('data-section');
      if (sectionId) validSectionIds.push(sectionId);
    });

    var validSections = [];
    validSectionIds.forEach(function(id) {
      var section = document.getElementById(id);
      if (section) validSections.push(section);
    });

    if (validSections.length === 0) return;

    function getNavLink(id) {
      return document.querySelector('.nav-link[data-section="' + id + '"]');
    }

    function setActive(id) {
      navLinks.forEach(function(link) {
        link.classList.remove('active');
      });
      var link = getNavLink(id);
      if (link) link.classList.add('active');
    }

    function getCurrentSection() {
      var scrollY = window.scrollY;
      var centerY = scrollY + window.innerHeight / 2;
      var bestSection = null;
      var bestScore = -Infinity;

      validSections.forEach(function(section) {
        var rect = section.getBoundingClientRect();
        var top = rect.top + scrollY;
        var bottom = top + rect.height;
        var height = rect.height;

        if (height <= 0) return;

        var score;
        if (centerY >= top && centerY < bottom) {
          score = 2;
        } else if (centerY < top) {
          score = 1;
        } else {
          score = 0;
        }

        if (score > bestScore) {
          bestScore = score;
          bestSection = section.getAttribute('id');
        }
      });

      return bestSection;
    }

    function getHashSection() {
      var hash = window.location.hash;
      if (!hash) return null;
      var id = hash.substring(1);
      if (validSectionIds.indexOf(id) === -1) return null;
      return document.getElementById(id) ? id : null;
    }

    function syncActiveSection() {
      var id = getHashSection() || getCurrentSection();
      if (id) setActive(id);
    }

    function scheduleActiveSync(delay) {
      var timer = setTimeout(function() {
        syncActiveSection();
      }, delay);
      activeTimers.push(timer);
    }

    var options = {
      root: null,
      rootMargin: '-20% 0px -20% 0px',
      threshold: 0
    };

    observer = new IntersectionObserver(function(entries) {
      var intersectingEntries = [];
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          intersectingEntries.push(entry);
        }
      });

      if (intersectingEntries.length > 0) {
        intersectingEntries.sort(function(a, b) {
          return a.boundingClientRect.top - b.boundingClientRect.top;
        });
        var topEntry = intersectingEntries[0];
        var id = topEntry.target.getAttribute('id');
        if (id && validSectionIds.indexOf(id) !== -1) {
          setActive(id);
        }
      }
    }, options);

    validSections.forEach(function(section) {
      observer.observe(section);
    });

    syncActiveSection();
    scheduleActiveSync(150);
    scheduleActiveSync(400);

    navLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        e.preventDefault();
        var href = link.getAttribute('href');
        if (!href) return;
        var targetId = href.substring(1);
        var target = document.getElementById(targetId);
        if (target) {
          var offset = 150;
          var rect = target.getBoundingClientRect();
          var top = rect.top + window.scrollY - offset;
          window.scrollTo({ top: top, behavior: 'smooth' });
          setActive(targetId);
        }
      }, { signal: eventSignal });
    });

    var scrollTimer = null;
    window.addEventListener('scroll', function() {
      if (scrollTimer) return;
      scrollTimer = setTimeout(function() {
        scrollTimer = null;
        syncActiveSection();
      }, 50);
    }, { passive: true, signal: eventSignal });

    window.addEventListener('hashchange', syncActiveSection, { signal: eventSignal });
    window.addEventListener('popstate', function() {
      scheduleActiveSync(0);
      scheduleActiveSync(150);
    }, { signal: eventSignal });
    window.addEventListener('pageshow', function() {
      scheduleActiveSync(0);
      scheduleActiveSync(150);
    }, { signal: eventSignal });

    isInitialized = true;
  }

  if (document.readyState === 'complete') {
    init();
  } else {
    window.addEventListener('load', function() {
      init();
    }, { once: true });
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
</script>

